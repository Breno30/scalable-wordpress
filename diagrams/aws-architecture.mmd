flowchart TB
    user([Internet user])

    subgraph aws["AWS Region: us-east-1"]
        igw[Internet Gateway]

        subgraph vpc["VPC 10.0.0.0/16"]
            subgraph aza["Availability Zone us-east-1a"]
                puba["Public subnet<br/>10.0.1.0/24"]
                nata[NAT Gateway A]
                pria["Private app subnet<br/>10.0.21.0/24"]
                ec2a[WordPress EC2]
                efsa[EFS mount target]
                dba["Isolated DB subnet<br/>10.0.11.0/24"]
            end

            subgraph azb["Availability Zone us-east-1b"]
                pubb["Public subnet<br/>10.0.2.0/24"]
                natb[NAT Gateway B]
                prib["Private app subnet<br/>10.0.22.0/24"]
                ec2b[WordPress EC2]
                efsb[EFS mount target]
                dbb["Isolated DB subnet<br/>10.0.12.0/24"]
            end

            alb[Application Load Balancer<br/>HTTP :80]
            efs[(Amazon EFS<br/>shared uploads)]
            rds[(Amazon RDS MySQL)]
            cache[(ElastiCache Serverless<br/>Valkey)]
        end
    end

    user -->|HTTP :80| igw --> alb
    alb --- puba
    alb --- pubb
    puba --- nata
    pubb --- natb
    pria -->|outbound only| nata --> igw
    prib -->|outbound only| natb --> igw
    pria --- ec2a
    prib --- ec2b
    alb -->|HTTP :80| ec2a
    alb -->|HTTP :80| ec2b
    ec2a -->|MySQL :3306| rds
    ec2b -->|MySQL :3306| rds
    rds --- dba
    rds --- dbb
    ec2a -->|NFS :2049| efsa --> efs
    ec2b -->|NFS :2049| efsb --> efs
    ec2a -.->|Redis protocol :6379| cache
    ec2b -.->|Redis protocol :6379| cache
    cache --- pria
    cache --- prib

    classDef public fill:#e8f4ff,stroke:#1473e6,color:#111;
    classDef private fill:#fff4cc,stroke:#b7791f,color:#111;
    classDef data fill:#e9f8ee,stroke:#27864a,color:#111;
    class alb,puba,pubb,nata,natb public;
    class pria,prib,ec2a,ec2b private;
    class rds,efs,cache,dba,dbb,efsa,efsb data;
