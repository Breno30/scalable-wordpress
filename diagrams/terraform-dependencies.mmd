flowchart LR
    vars[Input variables]
    vpc[VPC]
    igw[Internet gateway]
    publicnets[Public subnets A and B]
    appnets[Private app subnets A and B]
    dbnets[DB subnets A and B]
    routes[Public route table<br/>and associations]
    nat[NAT gateways A and B]
    privateroutes[Private app route tables]
    albsg[ALB security group]
    appsg[Application security group]
    dbsg[Database security group]
    efssg[EFS security group]
    redissg[Valkey security group]
    dbgroup[RDS subnet group]
    password[Random DB password]
    rds[RDS MySQL instance]
    efs[EFS file system]
    mounts[EFS mount targets]
    cache[ElastiCache Serverless Valkey]
    lt[EC2 launch template]
    tg[ALB target group]
    alb[Application Load Balancer]
    listener[HTTP listener]
    asg[Auto Scaling Group]
    policy[CPU target-tracking policy]
    output[Load balancer URL output]

    vars --> lt
    vars --> asg
    vpc --> publicnets
    vpc --> appnets
    vpc --> dbnets
    vpc --> igw --> routes
    publicnets --> routes
    publicnets --> nat --> privateroutes
    appnets --> privateroutes
    vpc --> albsg
    albsg --> appsg
    appsg --> dbsg
    appsg --> efssg
    appsg --> redissg
    dbnets --> dbgroup --> rds
    dbsg --> rds
    password --> rds
    appnets --> cache
    redissg --> cache
    efs --> mounts
    appnets --> mounts
    efssg --> mounts
    rds --> lt
    efs --> lt
    vpc --> tg
    publicnets --> alb
    routes --> alb
    albsg --> alb
    alb --> listener
    tg --> listener
    lt --> asg
    appnets --> asg
    tg --> asg
    asg --> policy
    alb --> output
