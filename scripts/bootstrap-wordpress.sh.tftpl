#!/bin/bash

readonly WORDPRESS_DIR="${wordpress_dir}"

dnf update -y
# Amazon Linux 2023 already supplies the curl command through curl-minimal.
# Installing the full curl package here would conflict with that default.
dnf install -y \
  amazon-efs-utils \
  jq \
  mariadb105 \
  nginx \
  nfs-utils \
  php \
  php-cli \
  php-curl \
  php-fpm \
  php-gd \
  php-intl \
  php-mbstring \
  php-mysqlnd \
  php-pecl-redis \
  php-xml \
  php-zip \
  unzip \
  amazon-cloudwatch-agent

# Run PHP-FPM as the same user that owns the WordPress files. Using an explicit
# user avoids the previous nginx/apache ownership mismatch.
sed -i \
  -e 's/^[;[:space:]]*user[[:space:]]*=.*/user = nginx/' \
  -e 's/^[;[:space:]]*group[[:space:]]*=.*/group = nginx/' \
  -e 's|^[;[:space:]]*listen[[:space:]]*=.*|listen = /run/php-fpm/www.sock|' \
  -e 's/^[;[:space:]]*listen.owner[[:space:]]*=.*/listen.owner = nginx/' \
  -e 's/^[;[:space:]]*listen.group[[:space:]]*=.*/listen.group = nginx/' \
  -e 's/^[;[:space:]]*listen.acl_users[[:space:]]*=.*/listen.acl_users = nginx/' \
  /etc/php-fpm.d/www.conf
sed -i 's/^memory_limit = .*/memory_limit = 512M/' /etc/php.ini

# Replace the package default with a server block that explicitly sends PHP
# scripts to PHP-FPM. try_files also enables normal WordPress permalink routing.
rm -f /etc/nginx/conf.d/default.conf
cat >/etc/nginx/conf.d/wordpress.conf <<'NGINX'
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    root /usr/share/nginx/html;
    index index.php index.html;
    client_max_body_size 64m;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "healthy\n";
    }

    location / {
        try_files $uri $uri/ /index.php?$args;
    }

    location ~ \.php$ {
        try_files $uri =404;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param HTTP_X_FORWARDED_PROTO $http_x_forwarded_proto;
        fastcgi_pass unix:/run/php-fpm/www.sock;
    }

    location ~ /\. {
        deny all;
    }
}
NGINX

rm -rf "$WORDPRESS_DIR"/*
curl --fail --location --retry 5 \
  https://raw.githubusercontent.com/wp-cli/builds/gh-pages/phar/wp-cli.phar \
  --output /usr/local/bin/wp
chmod 0755 /usr/local/bin/wp

secret_json="$(
  aws secretsmanager get-secret-value \
    --secret-id '${db_secret_arn}' \
    --query SecretString \
    --output text
)"

db_user="$(jq -er '.username' <<<"$secret_json")"
db_password="$(jq -er '.password' <<<"$secret_json")"

wp --allow-root core download --path="$WORDPRESS_DIR"
wp --allow-root config create \
  --path="$WORDPRESS_DIR" \
  --dbname='${db_name}' \
  --dbuser="$db_user" \
  --dbpass="$db_password" \
  --dbhost='${db_host}' \
  --dbcharset='utf8mb4' \
  --dbcollate='utf8mb4_unicode_ci'

# Derive identical salts from the managed database secret on every instance.
for salt_name in AUTH_KEY SECURE_AUTH_KEY LOGGED_IN_KEY NONCE_KEY AUTH_SALT SECURE_AUTH_SALT LOGGED_IN_SALT NONCE_SALT; do
  salt_value="$(printf '%s' "$db_password:$salt_name" | sha512sum | cut -d' ' -f1)"
  wp --allow-root config set "$salt_name" "$salt_value" --path="$WORDPRESS_DIR"
done
unset secret_json db_password salt_value

# The ALB terminates HTTPS and forwards HTTP to Nginx. 
sed -i '/\/\* That.s all, stop editing!/i if (isset($_SERVER["HTTP_X_FORWARDED_PROTO"]) && $_SERVER["HTTP_X_FORWARDED_PROTO"] === "https") { $_SERVER["HTTPS"] = "on"; }\n' "$WORDPRESS_DIR/wp-config.php"

# Configure phpredis client
wp --allow-root config set WP_REDIS_CLIENT 'phpredis' --path="$WORDPRESS_DIR"
wp --allow-root config set WP_REDIS_SCHEME 'tls' --path="$WORDPRESS_DIR"
wp --allow-root config set WP_REDIS_HOST '${cache_host}' --path="$WORDPRESS_DIR"
wp --allow-root config set WP_REDIS_PORT '${cache_port}' --raw --path="$WORDPRESS_DIR"
wp --allow-root config set WP_REDIS_PREFIX 'wordpress:' --path="$WORDPRESS_DIR"
wp --allow-root config set WP_REDIS_TIMEOUT '1' --raw --path="$WORDPRESS_DIR"
wp --allow-root config set WP_REDIS_READ_TIMEOUT '1' --raw --path="$WORDPRESS_DIR"
wp --allow-root config set DISALLOW_FILE_EDIT true --raw --path="$WORDPRESS_DIR"

wp --allow-root plugin install redis-cache --version=2.8.0 --force --path="$WORDPRESS_DIR" --activate

cp "$WORDPRESS_DIR/wp-content/plugins/redis-cache/includes/object-cache.php" "$WORDPRESS_DIR/wp-content/object-cache.php"

mkdir -p /efs "$WORDPRESS_DIR/wp-content/uploads"
echo '${efs_file_id}:/ /efs efs _netdev,tls 0 0' >> /etc/fstab
mount /efs
mkdir -p /efs/uploads
echo "/efs/uploads $WORDPRESS_DIR/wp-content/uploads none bind 0 0" >> /etc/fstab
mount "$WORDPRESS_DIR/wp-content/uploads"
chown -R nginx:nginx "$WORDPRESS_DIR" /efs/uploads

# Validate configuration before exposing the instance to the load balancer.
php-fpm --test
nginx -t
systemctl enable --now php-fpm nginx

# Create CloudWatch Agent configuration
cat <<'EOF' > /opt/aws/amazon-cloudwatch-agent/bin/config.json
{
  "agent": {
    "metrics_collection_interval": 60,
    "run_as_user": "cwagent"
  },
  "metrics": {
    "aggregation_dimensions": [
      [
        "InstanceId"
      ]
    ],
    "append_dimensions": {
      "AutoScalingGroupName": "$${aws:AutoScalingGroupName}",
      "ImageId": "$${aws:ImageId}",
      "InstanceId": "$${aws:InstanceId}",
      "InstanceType": "$${aws:InstanceType}"
    },
    "metrics_collected": {
      "mem": {
        "measurement": [
          "mem_used_percent"
        ],
        "metrics_collection_interval": 60
      },
      "disk": {
        "measurement": [
          "used_percent"
        ],
        "metrics_collection_interval": 60,
        "resources": [
          "*"
        ]
      }
    }
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/nginx/access.log",
            "log_group_name": "/wordpress/nginx/access",
            "log_stream_name": "{instance_id}",
            "retention_in_days": 7
          },
          {
            "file_path": "/var/log/nginx/error.log",
            "log_group_name": "/wordpress/nginx/error",
            "log_stream_name": "{instance_id}",
            "retention_in_days": 7
          }
        ]
      }
    }
  }
}
EOF

# Start CloudWatch Agent with the configuration
/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \
  -a fetch-config \
  -m ec2 \
  -s \
  -c file:/opt/aws/amazon-cloudwatch-agent/bin/config.json
